      "view/title": [
        {
          "command": "extensions-bookmark.addBookmark",
          "group": "navigation@1",
          "when": "view == extensionsBookmarkView"
        },
        {
          "command": "extensions-bookmark.searchBookmarks",
          "group": "navigation@2",
          "when": "view == extensionsBookmarkView"
        },
        {
          "submenu": "extensions-bookmark.groupBy",
          "group": "navigation@3",
          "when": "view == extensionsBookmarkView"
        },
        {
          "submenu": "extensions-bookmark.filterBy",
          "group": "navigation@4",
          "when": "view == extensionsBookmarkView"
        },
        {
          "submenu": "extensions-bookmark.sortBy",
          "group": "navigation@5",
          "when": "view == extensionsBookmarkView"
        },
        {
          "command": "extensions-bookmark.collapseTree",
          "group": "navigation@6",
          "when": "view == extensionsBookmarkView && extensions-bookmark.treeExpanded"
        },
        {
          "command": "extensions-bookmark.expandTree",
          "group": "navigation@6",
          "when": "view == extensionsBookmarkView && !extensions-bookmark.treeExpanded"
        },
        {
          "command": "extensions-bookmark.addFromList",
          "group": "9_more@1",
          "when": "view == extensionsBookmarkView"
        },
        {
          "command": "extensions-bookmark.addCategory",
          "group": "9_more@2",
          "when": "view == extensionsBookmarkView"
        },
        {
          "command": "extensions-bookmark.syncToData",
          "group": "9_more@3",
          "when": "view == extensionsBookmarkView"
        },
        {
          "command": "extensions-bookmark.syncFromData",
          "group": "9_more@5",
          "when": "view == extensionsBookmarkView"
        },
        {
          "command": "extensions-bookmark.importData",
          "group": "9_more@6",
          "when": "view == extensionsBookmarkView"
        },
        {
          "command": "extensions-bookmark.exportData",
          "group": "9_more@7",
          "when": "view == extensionsBookmarkView"
        }
      ],
      "extensions-bookmark.groupBy": [
        {
          "command": "extensions-bookmark.groupByRecent",
          "when": "extensions-bookmark.groupBy != 'recent'",
          "group": "1_group@1"
        },
        {
          "command": "extensions-bookmark.groupByRecentCurrent",
          "when": "extensions-bookmark.groupBy == 'recent'",
          "group": "1_group@1"
        },
        {
          "command": "extensions-bookmark.groupByCategory",
          "when": "extensions-bookmark.groupBy != 'category'",
          "group": "1_group@2"
        },
        {
          "command": "extensions-bookmark.groupByCategoryCurrent",
          "when": "extensions-bookmark.groupBy == 'category'",
          "group": "1_group@2"
        },
        {
          "command": "extensions-bookmark.groupByWanted",
          "when": "extensions-bookmark.groupBy != 'wanted'",
          "group": "1_group@3"
        },
        {
          "command": "extensions-bookmark.groupByWantedCurrent",
          "when": "extensions-bookmark.groupBy == 'wanted'",
          "group": "1_group@3"
        },
        {
          "command": "extensions-bookmark.groupByInstalled",
          "when": "extensions-bookmark.groupBy != 'installed'",
          "group": "1_group@4"
        },
        {
          "command": "extensions-bookmark.groupByInstalledCurrent",
          "when": "extensions-bookmark.groupBy == 'installed'",
          "group": "1_group@4"
        },
        {
          "command": "extensions-bookmark.groupByAge",
          "when": "extensions-bookmark.groupBy != 'age'",
          "group": "1_group@5"
        },
        {
          "command": "extensions-bookmark.groupByAgeCurrent",
          "when": "extensions-bookmark.groupBy == 'age'",
          "group": "1_group@5"
        },
        {
          "command": "extensions-bookmark.groupByFlat",
          "when": "extensions-bookmark.groupBy != 'flat'",
          "group": "1_group@6"
        },
        {
          "command": "extensions-bookmark.groupByFlatCurrent",
          "when": "extensions-bookmark.groupBy == 'flat'",
          "group": "1_group@6"
        }
      ],
      "extensions-bookmark.filterBy": [
        {
          "command": "extensions-bookmark.filterInput",
          "when": "extensions-bookmark.filter != 'input'",
          "group": "0_input@1"
        },
        {
          "command": "extensions-bookmark.filterInputCurrent",
          "when": "extensions-bookmark.filter == 'input'",
          "group": "0_input@1"
        },
        {
          "command": "extensions-bookmark.filterAll",
          "when": "extensions-bookmark.filter != 'all'",
          "group": "1_filter@1"
        },
        {
          "command": "extensions-bookmark.filterAllCurrent",
          "when": "extensions-bookmark.filter == 'all'",
