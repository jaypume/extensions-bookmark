{
  "name": "extensions-bookmark",
  "displayName": "Extensions Bookmark",
  "description": "Bookmark Visual Studio Code extensions for later use.",
  "icon": "media/extension-bookmarker-logo.png",
  "version": "1.1.0",
  "publisher": "pujie",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaypume/extensions-bookmark.git"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extensions-bookmark.add",
    "onCommand:extensions-bookmark.addBookmark",
    "onCommand:extensions-bookmark.viewBookmarks",
    "onCommand:extensions-bookmark.removeBookmark",
    "onCommand:extensions-bookmark.addCategory",
    "onCommand:extensions-bookmark.renameCategory",
    "onCommand:extensions-bookmark.removeCategory",
    "onCommand:extensions-bookmark.moveBookmark",
    "onCommand:extensions-bookmark.searchBookmarks",
    "onCommand:extensions-bookmark.addTagToList",
    "onCommand:extensions-bookmark.renameTagInList",
    "onCommand:extensions-bookmark.removeTagFromList",
    "onCommand:extensions-bookmark.addTagToBookmark",
    "onCommand:extensions-bookmark.removeTagFromBookmark",
    "onCommand:extensions-bookmark.filterByTag",
    "onCommand:extensions-bookmark.sortBookmarks",
    "onCommand:extensions-bookmark.addNote",
    "onCommand:extensions-bookmark.editNote",
    "onCommand:extensions-bookmark.removeNote",
    "onCommand:extensions-bookmark.viewDetails",
    "onCommand:extensions-bookmark.importData",
    "onCommand:extensions-bookmark.exportData",
    "onCommand:extensions-bookmark.removeAllData",
    "onView:extensionsBookmarkView"
  ],
  "main": "./extension",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extensionsBookmark",
          "title": "Extensions Bookmark",
          "icon": "media/activity-bar-icon.png"
        }
      ]
    },
    "views": {
      "extensionsBookmark": [
        {
          "id": "extensionsBookmarkView",
          "name": "List"
        }
      ]
    },
    "commands": [
      {
        "command": "extensions-bookmark.addBookmark",
        "title": "Add Bookmark"
      },
      {
        "command": "extensions-bookmark.viewBookmarks",
        "title": "View Bookmarks"
      },
      {
        "command": "extensions-bookmark.removeBookmark",
        "title": "Remove Bookmark"
      },
      {
        "command": "extensions-bookmark.addCategory",
        "title": "Add Category"
      },
      {
        "command": "extensions-bookmark.renameCategory",
        "title": "Rename Category"
      },
      {
        "command": "extensions-bookmark.removeCategory",
        "title": "Remove Category"
      },
      {
        "command": "extensions-bookmark.moveBookmark",
        "title": "Move Bookmark"
      },
      {
        "command": "extensions-bookmark.addTagToList",
        "title": "Add Tag to List"
      },
      {
        "command": "extensions-bookmark.renameTagInList",
        "title": "Rename Tag in List"
      },
      {
        "command": "extensions-bookmark.removeTagFromList",
        "title": "Remove Tag from List"
      },
      {
        "command": "extensions-bookmark.addTagToBookmark",
        "title": "Add Tag to Bookmark"
      },
      {
        "command": "extensions-bookmark.removeTagFromBookmark",
        "title": "Remove Tag from Bookmark"
      },
      {
        "command": "extensions-bookmark.filterByTag",
        "title": "Filter Bookmarks by Tag"
      },
      {
        "command": "extensions-bookmark.sortBookmarks",
        "title": "Sort Bookmarks"
      },
      {
        "command": "extensions-bookmark.addNote",
        "title": "Add Note to Bookmark"
      },
      {
        "command": "extensions-bookmark.editNote",
        "title": "Edit Note"
      },
      {
        "command": "extensions-bookmark.removeNote",
        "title": "Remove Note from Bookmark"
      },
      {
        "command": "extensions-bookmark.viewDetails",
        "title": "View Details"
      },
      {
        "command": "extensions-bookmark.importData",
        "title": "Import Data"
      },
      {
        "command": "extensions-bookmark.exportData",
        "title": "Export Data"
      },
      {
        "command": "extensions-bookmark.removeAllData",
        "title": "Remove All Data"
      },
      {
        "command": "extensions-bookmark.add",
        "title": "Add",
        "icon": {
          "light": "media/light/actions-icon.png",
          "dark": "media/dark/actions-icon.png"
        }
      },
      {
        "command": "extensions-bookmark.searchBookmarks",
        "title": "Search",
        "icon": {
          "light": "media/light/search-icon.png",
          "dark": "media/dark/search-icon.png"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "extensions-bookmark.add",
          "group": "navigation",
          "when": "view == extensionsBookmarkView"
        },
        {
          "command": "extensions-bookmark.searchBookmarks",
          "group": "navigation",
          "when": "view == extensionsBookmarkView"
        }
      ],
      "view/item/context": [
        {
          "command": "extensions-bookmark.removeBookmark",
          "group": "0_extension_bookmarker",
          "when": "view == extensionsBookmarkView && viewItem == bookmarkedExtension"
        },
        {
          "command": "extensions-bookmark.renameCategory",
          "group": "1_category",
          "when": "view == extensionsBookmarkView && viewItem == category && viewItem != defaultCategory"
        },
        {
          "command": "extensions-bookmark.removeCategory",
          "group": "1_category",
          "when": "view == extensionsBookmarkView && viewItem == category && viewItem != defaultCategory"
        },
        {
          "command": "extensions-bookmark.moveBookmark",
          "group": "0_extension_bookmarker",
          "when": "view == extensionsBookmarkView && viewItem == bookmarkedExtension"
        },
        {
          "command": "extensions-bookmark.addTagToBookmark",
          "group": "0_extension_bookmarker",
          "when": "view == extensionsBookmarkView && viewItem == bookmarkedExtension"
        },
        {
          "command": "extensions-bookmark.removeTagFromBookmark",
          "group": "0_extension_bookmarker",
          "when": "view == extensionsBookmarkView && viewItem == bookmarkedExtension"
        },
        {
          "command": "extensions-bookmark.addNote",
          "group": "0_extension_bookmarker",
          "when": "view == extensionsBookmarkView && viewItem == bookmarkedExtension"
        },
        {
          "command": "extensions-bookmark.editNote",
          "group": "0_extension_bookmarker",
          "when": "view == extensionsBookmarkView && viewItem == bookmarkedExtension"
        },
        {
          "command": "extensions-bookmark.removeNote",
          "group": "0_extension_bookmarker",
          "when": "view == extensionsBookmarkView && viewItem == bookmarkedExtension"
        },
        {
          "command": "extensions-bookmark.viewDetails",
          "group": "0_extension_bookmarker",
          "when": "view == extensionsBookmarkView && viewItem == bookmarkedExtension"
        }
      ]
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/node": "^12.20.4",
    "tslint": "^5.12.1",
    "typescript": "^4.4.3",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "axios": "^1.4.0"
  }
}